{
  "expo": {
    "name": "HomeLib",
    "slug": "homelib",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homelib",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#144C3A",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.homelib.app",
      "adaptiveIcon": {
        "backgroundColor": "#144C3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HomeLib to use the camera to scan book barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow HomeLib to use the camera to photograph book covers.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#144C3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#121A16",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Lora",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/lora/400Regular/Lora_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/lora/600SemiBold/Lora_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/lora/700Bold/Lora_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "PlusJakartaSans",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      "./plugins/with-clean-android-build"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "269c218a-c72b-45ba-907a-f3c52e3874dd"
      }
    },
    "owner": "manverupl"
  }
}
